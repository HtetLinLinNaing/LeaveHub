NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required for server-side Supabase reads/writes (lib/dal/admin-client.ts).
# Get this from Supabase dashboard -> Settings -> API -> service_role.
# Never expose to the browser; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo environments only. Never enable this command in a real-user environment.
ALLOW_DEMO_AUTH_BOOTSTRAP=false
DEMO_AUTH_PASSWORD=replace-with-at-least-12-characters
